{
  "name": "jomisacu/roles-and-permissions",
  "description": "A simple way to handle roles and permissions",
  "type": "library",
  "license": "MIT",
  "bin": [
    "bin/jomisacu-roles-and-permissions"
  ],
  "autoload": {
    "psr-4": {
      "Jomisacu\\RolesAndPermissions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jomisacu\\RolesAndPermissions\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "jomisacu",
      "email": "jomisacu.software@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*"
  },
  "suggest": {
    "ext-pdo_mysql": "Required to use the MySQL repository implementations"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.1"
  }
}
